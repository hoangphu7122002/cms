---
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

type Props = {
  kind: CollectionEntry<"posts">["data"]["kind"];
  class?: string;
};

const { kind, class: className } = Astro.props;
const t = useTranslations(Astro.currentLocale);

// Full class names so Tailwind sees them; colour is never the only signal,
// the badge always carries the kind word.
const kindClass = {
  series: "bg-kind-series-bg text-kind-series",
  concept: "bg-kind-concept-bg text-kind-concept",
  fieldnote: "bg-kind-fieldnote-bg text-kind-fieldnote",
  method: "bg-kind-method-bg text-kind-method",
} as const;
---

<span
  data-kind={kind}
  class:list={[
    "inline-block rounded-sm px-1.5 py-0.5 text-xs leading-none font-semibold tracking-wider uppercase",
    kindClass[kind],
    className,
  ]}
>
  {t.kinds[kind]}
</span>
