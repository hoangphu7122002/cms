---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const { site, socials, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
const copyright = `${t.footer.copyright} \u00a9 ${currentYear} ${site.author}. ${t.footer.allRightsReserved}`;

const SOCIAL_LABELS: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
};
const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const links = [
  {
    href: `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`,
    label: t.footer.rss,
  },
  ...(features.showArchives
    ? [
        {
          href: getRelativeLocaleUrl(locale, "archives"),
          label: t.nav.archives,
        },
      ]
    : []),
  ...socials
    .filter(({ name }) => name !== "mail")
    .map(({ name, url }) => ({
      href: url,
      label: SOCIAL_LABELS[name] ?? capitalise(name),
    })),
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground mt-12 flex flex-col gap-4 border-t py-8 text-sm sm:flex-row sm:justify-between"
  >
    <div class="space-y-1">
      <p class="text-foreground font-semibold tracking-tight">{site.title}</p>
      <p>{t.footer.sourceNote}</p>
      <p>
        {copyright}
      </p>
    </div>
    <nav aria-label={t.footer.navLabel}>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 sm:justify-end">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                {href}
                class="hover:text-accent underline decoration-1 underline-offset-4"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
