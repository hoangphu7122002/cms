---
import { type CollectionEntry, getCollection } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { readingMinutes } from "@/utils/readingTime";
import {
  findCollection,
  getCollections,
  positionIn,
} from "@/utils/getCollections";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  variant?: "h2" | "h3";
  /** Other posts of the same collection, shown as one line under the card. */
  more?: CollectionEntry<"posts">[];
} & CollectionEntry<"posts">;

const MAX_TAGS = 3;
const MAX_MORE = 3;

const {
  variant: Heading = "h2",
  more = [],
  id,
  data,
  filePath,
  body,
} = Astro.props;

const { title, description, tags, pubDatetime, modDatetime, timezone } = data;
const t = useTranslations(Astro.currentLocale);
const minRead = tplStr(t.post.minRead, { count: readingMinutes(body) });
// getCollection is cached per build, so this stays cheap per card
const collection = findCollection(
  Astro.props,
  getCollections(await getCollection("posts"))
);
const grouped = more.length > 0;
const partLabel = !collection
  ? ""
  : grouped
    ? tplStr(t.home.postsCount, { count: more.length + 1 })
    : tplStr(t.post.part, { n: positionIn(Astro.props, collection) });
const collectionLabel = collection
  ? grouped
    ? collection.rootName
    : collection.path.join(" › ")
  : "";
const shownMore = more.slice(0, MAX_MORE);
const shownTags = tags.slice(0, MAX_TAGS);
---

<li
  class="group border-border relative border-b py-6 first:pt-2 last:border-b-0"
>
  {
    collection && (
      <p class="font-ui text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 text-xs tracking-wider uppercase">
        <span>{collectionLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{partLabel}</span>
      </p>
    )
  }

  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      { "mt-2": collection },
      "inline-block",
      // the link covers the whole card; tags sit above it (z-10)
      "after:absolute after:inset-0 after:content-['']",
    ]}
  >
    <Heading
      transition:name={toTransitionName(id)}
      class="text-foreground group-hover:text-accent font-serif text-xl leading-snug font-semibold transition-colors motion-reduce:transition-none"
    >
      {title}
    </Heading>
  </a>

  <p class="text-muted-foreground mt-1.5 line-clamp-2">{description}</p>

  <div
    class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm"
  >
    <Datetime {pubDatetime} {modDatetime} {timezone} showIcon={false} />
    <span aria-hidden="true">·</span>
    <span>{minRead}</span>
    {
      shownTags.length > 0 && (
        <ul class="relative z-10 flex flex-wrap gap-x-1.5 max-sm:-my-2.5 sm:ms-2 sm:gap-y-1.5">
          {shownTags.map(tag => (
            <Tag
              tag={slugifyStr(tag)}
              tagName={tag}
              size="sm"
              transition={false}
            />
          ))}
        </ul>
      )
    }
  </div>
  {
    shownMore.length > 0 && (
      <p class="font-ui text-muted-foreground relative z-10 mt-3 text-sm">
        <span>+ </span>
        {shownMore.map((p, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a
              href={getPostUrl(p.id, p.filePath, Astro.currentLocale)}
              class="hover:text-accent decoration-accent underline underline-offset-4"
            >
              {p.data.title}
            </a>
          </>
        ))}
        {more.length > MAX_MORE && <span> · +{more.length - MAX_MORE}</span>}
      </p>
    )
  }
</li>
