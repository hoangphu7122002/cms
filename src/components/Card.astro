---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { readingMinutes } from "@/utils/readingTime";
import { seriesLabel } from "@/utils/seriesLabel";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import KindBadge from "./KindBadge.astro";
import Tag from "./Tag.astro";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const MAX_TAGS = 3;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const {
  title,
  description,
  kind,
  series,
  part,
  tags,
  pubDatetime,
  modDatetime,
  timezone,
} = data;
const t = useTranslations(Astro.currentLocale);
const minRead = tplStr(t.post.minRead, { count: readingMinutes(body) });
const seriesName = seriesLabel(series);
const partLabel = part !== undefined ? tplStr(t.post.part, { n: part }) : "";
const shownTags = tags.slice(0, MAX_TAGS);
---

<li
  class="group border-border relative border-b py-6 first:pt-2 last:border-b-0"
>
  <p
    class="font-ui text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 text-xs tracking-wider uppercase"
  >
    <KindBadge {kind} />
    {
      seriesName && (
        <>
          <span aria-hidden="true">·</span>
          <span>{seriesName}</span>
        </>
      )
    }
    {
      partLabel && (
        <>
          <span aria-hidden="true">·</span>
          <span>{partLabel}</span>
        </>
      )
    }
  </p>

  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "mt-2 inline-block",
      // the link covers the whole card; tags sit above it (z-10)
      "after:absolute after:inset-0 after:content-['']",
    ]}
  >
    <Heading
      transition:name={toTransitionName(id)}
      class="text-foreground group-hover:text-accent font-serif text-xl leading-snug font-semibold transition-colors motion-reduce:transition-none"
    >
      {title}
    </Heading>
  </a>

  <p class="text-muted-foreground mt-1.5 line-clamp-2">{description}</p>

  <div
    class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm"
  >
    <Datetime {pubDatetime} {modDatetime} {timezone} showIcon={false} />
    <span aria-hidden="true">·</span>
    <span>{minRead}</span>
    {
      shownTags.length > 0 && (
        <ul class="relative z-10 flex flex-wrap gap-1.5 sm:ms-2">
          {shownTags.map(tag => (
            <Tag
              tag={slugifyStr(tag)}
              tagName={tag}
              size="sm"
              transition={false}
            />
          ))}
        </ul>
      )
    }
  </div>
</li>
