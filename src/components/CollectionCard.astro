---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import type { CollectionRoot } from "@/utils/getCollections";
import CollectionCover from "./CollectionCover.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  root: CollectionRoot;
  /** Load the cover eagerly (first card above the fold). */
  eager?: boolean;
  headingLevel?: "h2" | "h3";
};

const { root, eager = false, headingLevel: Heading = "h3" } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const MAX_SHOWN = 3;

const grouped = root.leaves.length > 1;
const meta = [
  tplStr(root.count === 1 ? t.home.postCount : t.home.postsCount, {
    count: root.count,
  }),
  grouped
    ? tplStr(t.home.groupsCount, { count: root.leaves.length })
    : undefined,
].filter(Boolean);
const pageUrl = getRelativeLocaleUrl(locale, `collections/${root.slug}`);
const url = (p: CollectionEntry<"posts">) =>
  getPostUrl(p.id, p.filePath, locale);
// the start post has its own button, so groups list the rest
const groups = root.leaves.map(leaf => {
  const posts = leaf.posts.filter(p => p.id !== root.start?.id);
  return { leaf, shown: posts.slice(0, MAX_SHOWN), total: leaf.posts.length };
});
---

<li
  class="border-border flex flex-col rounded-xl border bg-(--surface) p-5 sm:p-6"
>
  {
    root.cover && (
      <a href={pageUrl} tabindex="-1" aria-hidden="true" class="mb-5 block">
        <CollectionCover path={root.cover} {eager} />
      </a>
    )
  }

  <Heading class="font-serif text-xl leading-snug font-semibold sm:text-2xl">
    <a
      href={pageUrl}
      class="text-foreground hover:text-accent decoration-accent hover:underline hover:underline-offset-4"
    >
      {root.name}
    </a>
  </Heading>
  {
    root.description && (
      <p class="text-foreground/85 mt-2 text-base leading-relaxed">
        {root.description}
      </p>
    )
  }
  <p class="font-ui text-muted-foreground mt-2 text-sm">
    {meta.join(" · ")}
  </p>

  <div class="font-ui mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
    {
      root.start && (
        <a
          href={url(root.start)}
          class="bg-accent text-accent-foreground inline-flex min-h-11 items-center gap-1.5 rounded-lg px-4 font-semibold hover:opacity-90"
        >
          {t.home.startHere}
          <span class="sr-only">: {root.start.data.title}</span>
          <span aria-hidden="true">→</span>
        </a>
      )
    }
    <a
      href={pageUrl}
      class="text-accent decoration-accent inline-flex min-h-11 items-center underline-offset-4 hover:underline"
    >
      {tplStr(t.home.seeAll, { count: root.count })}
      <span aria-hidden="true">&nbsp;→</span>
    </a>
  </div>

  <div
    class:list={[
      "border-border mt-5 grid gap-x-8 gap-y-5 border-t pt-5",
      { "sm:grid-cols-2": grouped },
    ]}
  >
    {
      groups.map(g => (
        <div>
          {grouped && (
            <p class="font-ui text-muted-foreground text-sm font-semibold">
              {g.leaf.name}
              <span class="font-normal"> · {g.total}</span>
            </p>
          )}
          <ol class="font-ui mt-2 space-y-2 text-base">
            {g.shown.map(post => {
              const n = g.leaf.posts.indexOf(post) + 1;
              return (
                <li class="flex items-baseline gap-2.5">
                  <span
                    aria-hidden="true"
                    class="text-muted-foreground w-5 flex-none text-end text-sm tabular-nums"
                  >
                    {n}
                  </span>
                  <span class="sr-only">{tplStr(t.post.part, { n })}:</span>
                  <a
                    href={url(post)}
                    class="text-foreground hover:text-accent decoration-muted-foreground/40 hover:decoration-accent leading-snug underline underline-offset-4 max-sm:inline-block max-sm:py-1"
                  >
                    {post.data.title}
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      ))
    }
  </div>
</li>
