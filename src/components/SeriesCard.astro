---
import KindBadge from "./KindBadge.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { seriesTitle, type SeriesGroup } from "@/utils/getSeries";
import { tplStr, useTranslations } from "@/i18n";

type Props = { group: SeriesGroup };

const MAX_PARTS = 5;

const { group } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const title = seriesTitle(group, t);
const count = group.posts.length;
const countLabel = tplStr(count === 1 ? t.home.partCount : t.home.partsCount, {
  count,
});
const shown = group.posts.slice(0, MAX_PARTS);
---

<li class="border-border flex flex-col rounded-lg border p-4">
  <p
    class="font-ui text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 text-xs"
  >
    {/* a generic series is titled by its kind already, so no badge */}
    {group.name && <KindBadge kind={group.kind} />}
    {group.name && group.project && <span aria-hidden="true">·</span>}
    {group.project && <span class="font-mono">{group.project}</span>}
  </p>

  <h3
    class="text-foreground mt-2 font-serif text-lg leading-snug font-semibold"
  >
    {title}
  </h3>
  <p class="font-ui text-muted-foreground text-sm">{countLabel}</p>

  <ol class="font-ui mt-3 space-y-1.5 text-sm">
    {
      shown.map((post, i) => (
        <li class="flex gap-2">
          <span
            aria-hidden="true"
            class="text-muted-foreground w-6 flex-none text-end tabular-nums"
          >
            {post.data.part ?? i + 1}
          </span>
          <span class="sr-only">
            {tplStr(t.post.part, { n: post.data.part ?? i + 1 })}:
          </span>
          <a
            href={getPostUrl(post.id, post.filePath, Astro.currentLocale)}
            class="text-foreground hover:text-accent decoration-accent underline underline-offset-4"
          >
            {post.data.title}
          </a>
        </li>
      ))
    }
  </ol>
  {
    count > MAX_PARTS && (
      <p class="font-ui text-muted-foreground ms-8 mt-2 text-sm">
        +{count - MAX_PARTS}
      </p>
    )
  }
</li>
