---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** Off where the same tag repeats on one page (cards): names must be unique. */
  transition?: boolean;
  class?: string;
};

const {
  tag,
  tagName,
  size = "lg",
  transition = true,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);
const chipClass = [
  "font-ui inline-block rounded-full border border-border leading-snug",
  "text-muted-foreground transition-colors motion-reduce:transition-none",
  "hover:border-accent hover:text-accent focus-visible:text-accent",
  { "px-2.5 py-0.5 text-xs": size === "sm" },
  { "px-3 py-1 text-sm": size === "lg" },
];
---

<li class={className}>
  {
    transition ? (
      <a {href} transition:name={tag} class:list={chipClass}>
        {tagName}
      </a>
    ) : (
      <a {href} class:list={chipClass}>
        {tagName}
      </a>
    )
  }
</li>
