---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** Off where the same tag repeats on one page (cards): names must be unique. */
  transition?: boolean;
  class?: string;
};

const {
  tag,
  tagName,
  size = "lg",
  transition = true,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);
// the link is the tap area (44px tall on phones); the pill is drawn inside
const linkClass =
  "group/tag inline-flex items-center justify-center max-sm:min-h-11 max-sm:min-w-11";
const chipClass = [
  "font-ui inline-block rounded-full border border-border leading-snug",
  "text-muted-foreground transition-colors motion-reduce:transition-none",
  "group-hover/tag:border-accent group-hover/tag:text-accent group-focus-visible/tag:text-accent",
  { "px-2.5 py-0.5 text-xs": size === "sm" },
  { "px-3 py-1 text-sm": size === "lg" },
];
---

<li class={className}>
  {
    transition ? (
      <a {href} transition:name={tag} class={linkClass}>
        <span class:list={chipClass}>{tagName}</span>
      </a>
    ) : (
      <a {href} class={linkClass}>
        <span class:list={chipClass}>{tagName}</span>
      </a>
    )
  }
</li>
