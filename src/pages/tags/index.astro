---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { TAG_GROUPS } from "@/tags";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const groups = TAG_GROUPS.map(group => ({
  group,
  tags: tags.filter(tag => tag.group === group),
})).filter(g => g.tags.length > 0);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    {
      groups.map(({ group, tags: list }) => (
        <section class="mt-10 first:mt-0" aria-label={group}>
          <h2 class="section-label border-border border-b pb-2">{group}</h2>
          <ul class="mt-2">
            {list.map(({ tag, tagName, description, count }) => (
              <li class="border-border flex items-baseline gap-4 border-b py-3 last:border-b-0">
                <a
                  href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
                  class="text-foreground hover:text-accent decoration-accent w-44 flex-none font-serif text-lg font-semibold underline-offset-4 hover:underline max-sm:w-auto"
                >
                  {tagName}
                </a>
                <p class="text-muted-foreground min-w-0 flex-1 text-sm leading-relaxed max-sm:hidden">
                  {description}
                </p>
                <span class="text-muted-foreground ms-auto text-sm tabular-nums">
                  {count}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Main>

  <Footer />
</Layout>
