---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { partOfLabel, type PostCollection } from "@/utils/getCollections";
import { tplStr, useTranslations } from "@/i18n";

type Props = {
  post: CollectionEntry<"posts">;
  collection: PostCollection;
  class?: string;
};

const { post, collection, class: className } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const position = partOfLabel(post, collection, t);
const many = collection.posts.length > 1;
---

<nav
  aria-label={`${t.collection.label}: ${collection.name}`}
  data-pagefind-ignore
  class:list={[
    "border-border font-ui rounded-lg border px-4 py-3 text-sm",
    className,
  ]}
>
  {
    many ? (
      <details>
        <summary class="cursor-pointer">
          <span class="text-muted-foreground">{t.collection.label}:</span>{" "}
          <span class="text-foreground font-semibold">{collection.name}</span>
          <span aria-hidden="true" class="text-muted-foreground">
            {" "}
            ·{" "}
          </span>
          <span class="text-muted-foreground">{position}</span>
        </summary>
        <ol class="mt-3 space-y-1">
          {collection.posts.map((p, i) => {
            const current = p.id === post.id;
            return (
              <li
                class:list={[
                  "flex gap-2 border-s-2 ps-2",
                  current ? "border-accent" : "border-transparent",
                ]}
              >
                <span
                  aria-hidden="true"
                  class="text-muted-foreground w-5 flex-none text-end tabular-nums"
                >
                  {i + 1}
                </span>
                <span class="sr-only">
                  {tplStr(t.post.part, { n: i + 1 })}:
                </span>
                {current ? (
                  <span
                    aria-current="page"
                    class="text-foreground font-semibold"
                  >
                    {p.data.title}
                  </span>
                ) : (
                  <a
                    href={getPostUrl(p.id, p.filePath, Astro.currentLocale)}
                    class="text-foreground hover:text-accent decoration-accent underline underline-offset-4"
                  >
                    {p.data.title}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </details>
    ) : (
      <p>
        <span class="text-muted-foreground">{t.collection.label}:</span>{" "}
        <span class="text-foreground font-semibold">{collection.name}</span>
        <span aria-hidden="true" class="text-muted-foreground">
          {" "}
          ·{" "}
        </span>
        <span class="text-muted-foreground">{position}</span>
      </p>
    )
  }
</nav>
