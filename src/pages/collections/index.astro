---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import CollectionCard from "@/components/CollectionCard.astro";
import { getCollectionRoots } from "@/utils/getCollections";
import { useTranslations } from "@/i18n";
import config from "@/config";

const roots = getCollectionRoots(await getCollection("posts"));
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.collectionsTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.collectionsTitle} pageDesc={t.pages.collectionsDesc}>
    <ul class="grid grid-cols-1 gap-6">
      {
        roots.map((root, i) => (
          <CollectionCard {root} eager={i === 0} headingLevel="h2" />
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
