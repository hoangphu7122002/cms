---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import CollectionCard from "@/components/CollectionCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getCollectionRoots } from "@/utils/getCollections";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const collections = getCollectionRoots(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-8 pb-4">
      <h1 class="page-title mt-4 mb-4 inline-block sm:mt-8">
        Lessons from building systems
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block align-middle max-sm:-my-3 max-sm:p-3"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p
        class="text-muted-foreground max-w-[60ch] font-serif text-lg leading-relaxed italic"
      >
        LLM serving, agents and system design: the numbers, the limits of each
        measurement, and what went wrong.
      </p>
      {
        socials.length > 0 && (
          <div class="font-ui text-muted-foreground mt-4 flex items-center text-sm">
            <span class="sr-only">{t.home.socialLinks}:</span>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b pt-12 pb-6">
          <h2 class="section-label border-border border-b pb-2">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      collections.length > 0 && (
        <section
          id="collections"
          aria-labelledby="collections-heading"
          class="pt-12 pb-12"
        >
          <h2
            id="collections-heading"
            class="section-label border-border border-b pb-2"
          >
            {t.home.collections}
          </h2>
          <ul class="mt-6 grid grid-cols-1 gap-6">
            {collections.map((root, i) => (
              <CollectionCard {root} eager={i === 0} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
