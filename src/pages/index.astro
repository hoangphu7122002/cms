---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import CollectionCard from "@/components/CollectionCard.astro";
import LatestRow from "@/components/LatestRow.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { collectionOf, getCollectionRoots } from "@/utils/getCollections";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;
const LATEST_COUNT = 5;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
// one entry per collection root, so a burst of series posts takes one slot
type Entry = { post: (typeof sortedPosts)[number]; more: typeof sortedPosts };
const entries = new Map<string, Entry>();
for (const post of sortedPosts) {
  const key = collectionOf(post)?.rootKey ?? `post:${post.id}`;
  const entry = entries.get(key);
  if (entry) {
    // the part-0 "Start here" post leads its group when it is in the batch
    if (post.data.part === 0) {
      entry.more.unshift(entry.post);
      entry.post = post;
    } else entry.more.push(post);
  } else if (entries.size < LATEST_COUNT) {
    entries.set(key, { post, more: [] });
  }
}
const latestPosts = [...entries.values()];
const collections = getCollectionRoots(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <h1
        class="my-4 inline-block text-[2rem] leading-tight font-bold sm:mt-8 sm:mb-5 sm:text-5xl"
      >
        Hoang Phu: Lessons
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block align-middle max-sm:-my-3 max-sm:p-3"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-foreground/85 max-w-[60ch] text-lg leading-relaxed">
        What I learn while building and measuring LLM serving systems on GPUs:
        the numbers, the limits of each measurement, and what went wrong.
      </p>
      {
        socials.length > 0 && (
          <div class="font-ui text-muted-foreground mt-4 flex items-center text-sm">
            <span class="sr-only">{t.home.socialLinks}:</span>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      collections.length > 0 && (
        <section
          id="collections"
          aria-labelledby="collections-heading"
          class="border-border border-b pt-12 pb-12"
        >
          <h2
            id="collections-heading"
            class="text-2xl font-semibold tracking-wide"
          >
            {t.home.collections}
          </h2>
          <ul class="mt-6 grid grid-cols-1 gap-6">
            {collections.map((root, i) => (
              <CollectionCard {root} eager={i === 0} />
            ))}
          </ul>
        </section>
      )
    }

    {
      latestPosts.length > 0 && (
        <section
          id="latest"
          aria-labelledby="latest-heading"
          class="pt-12 pb-6"
        >
          <h2 id="latest-heading" class="text-2xl font-semibold tracking-wide">
            {t.home.latest}
          </h2>
          <ul class="mt-2">
            {latestPosts.map(({ post, more }) => (
              <LatestRow {post} {more} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="max-sm:min-h-11"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
